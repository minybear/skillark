{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegistryItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "externalId",
    "name",
    "locator"
  ],
  "properties": {
    "sourceId": {
      "type": "string"
    },
    "externalId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "locator": {
      "type": "object"
    },
    "rawMetadata": {
      "type": "object"
    }
  }
}